      "parameters": {
        "jsCode": "const s=$input.first().json;const task=s.current_task||{};const text=String(task.objective||'')+' '+String(task.expected_result||'');const critical=/(production\\s+(deploy|deployment|database)|payment\\s+config|credential|secret|api\\s*key|private\\s*key|destructive|drop\\s+table|truncate|production\\s+database|migration\\s*write)/i;const rawTarget=s.writer_target??s.director_brief?.writer_target;const writerTarget=typeof rawTarget==='string'?rawTarget:'';const targetAllowed=writerTarget==='PRODUCTION'||writerTarget==='SMOKE_FIXTURE';const safe=Boolean(task.task_id)&&s.codex_available===true&&!critical.test(text)&&targetAllowed;let reason='NONE';if(!task.task_id)reason='Missing task.';else if(s.codex_available!==true)reason='Codex unavailable.';else if(critical.test(text))reason='Critical operation is not eligible for Host Writer.';else if(!targetAllowed)reason='Writer target must be exactly PRODUCTION or SMOKE_FIXTURE; missing, path-like, case/whitespace variants, and unknown values are rejected.';return [{json:{...s,writer_target:writerTarget,writer_target_valid:targetAllowed,child_route:safe?'SAFE':'BLOCKED',child_block_reason:safe?'NONE':reason}}];"
