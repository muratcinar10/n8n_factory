    {
      "parameters": {
        "jsCode": "function uuid(){return'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.random()*16|0,v=c==='x'?r:(r&3|8);return v.toString(16);});}const s=$input.first().json,t=s.current_task,id=uuid();const roots=Object.freeze({PRODUCTION:'/data/host-writer',SMOKE_FIXTURE:'/data/smoke-host-writer'});const queueRoot=roots[s.writer_target];if(!queueRoot)throw new Error('Invalid symbolic writer target; refusing filesystem access.');const prompt=`AI Product Factory V4 controlled repository task.\\nTASK_ID: ${t.task_id}\\nOBJECTIVE: ${t.objective}\\nEXPECTED_RESULT: ${t.expected_result}\\nACCEPTANCE_CRITERIA: ${JSON.stringify(t.acceptance_criteria||[])}\\nTEST_REQUIREMENTS: ${JSON.stringify(t.test_requirements||[])}\\nThis is attempt ${t.attempt||1}. Work only in the approved repository. Do not read .env/secrets/credentials. Do not write production databases. Do not run migrations. Do not deploy. Do not use destructive Git. Do not commit or push. Do not weaken sandboxes. Do not access the Docker socket. Preserve unrelated work. Run proportionate non-production tests. Return changed/new/deleted files and a concise summary. Never auto-accept changes.`;return [{json:{sprint_state:s,writer_target:s.writer_target,job_id:id,job_path:`${queueRoot}/inbox/${id}.json`,result_path:`${queueRoot}/results/${id}.json`,job_payload:JSON.stringify({prompt},null,2)}}];"
