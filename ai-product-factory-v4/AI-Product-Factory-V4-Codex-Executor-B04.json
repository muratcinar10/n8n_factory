    {
      "parameters": {
        "jsCode": "const c=$input.first().json,raw=c.result;if(!raw||typeof raw!=='object')throw new Error('Invalid Host Writer result');const reasons=Array.isArray(raw.accepted_state_drift_reasons)?raw.accepted_state_drift_reasons:[];let status='FAILED';if(raw.ok===true&&raw.task_completed===true&&['awaiting_acceptance','accepted'].includes(raw.acceptance_status))status='SUCCESS';else if(raw.ok===false&&raw.task_completed===false&&raw.returncode===null&&raw.audit_recorded===false&&raw.accepted_state_drift_detected===true&&reasons.some(r=>typeof r==='string'&&r.startsWith('pre_run_')))status='PREFLIGHT_DRIFT';return [{json:{...(c.sprint_state||{}),executor_kind:'CODEX',job_id:c.job_id,execution_status:status,ok:raw.ok===true,task_completed:raw.task_completed===true,returncode:raw.returncode??null,acceptance_status:raw.acceptance_status||'not_eligible',audit_recorded:raw.audit_recorded===true,changed_files:Array.isArray(raw.changed_files)?raw.changed_files:[],new_files:Array.isArray(raw.new_files)?raw.new_files:[],deleted_files:Array.isArray(raw.deleted_files)?raw.deleted_files:[],accepted_state_drift_detected:raw.accepted_state_drift_detected===true,accepted_state_drift_reasons:reasons,summary:typeof raw.codex_result?.summary==='string'?raw.codex_result.summary:'',stderr:typeof raw.stderr==='string'?raw.stderr:''}}];"
